#!/usr/bin/env python3
"""Terminal-based local assistant agent.

A local, interactive assistant for file and shell tasks.
"""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from pathlib import Path

SAFE_DEFAULT_ROOT = Path.cwd()

HELP_TEXT = """
Commands:
  /help
  /exit
  /pwd
  /cd <path>
  /history
  /list [path]
  /tree [path]
  /search <pattern> [path]
  /read <path>
  /write <path> ::: <content>
  /append <path> ::: <content>
  /mkdir <path>
  /delete <path>
  /copy <src> ::: <dest>
  /move <src> ::: <dest>
  /run <shell command>

Natural-language shortcuts also work:
  list files
  read file notes.txt
  create folder docs
  delete file old.txt
  run: git status
""".strip()


class LocalAssistant:
    def __init__(self, root: Path, auto_approve: bool = False, max_read_kb: int = 256) -> None:
        self.root = root.resolve()
        self.cwd = self.root
        self.auto_approve = auto_approve
        self.max_read_bytes = max_read_kb * 1024
        self.history: list[str] = []

    def start(self) -> None:
        print("🤖 Local Assistant is running.")
        print(f"Root sandbox: {self.root}")
        print("Type /help for commands, /exit to quit.")
        while True:
            try:
                prompt = input(f"\nYou ({self._display_cwd()})> ").strip()
            except (EOFError, KeyboardInterrupt):
                print("\nGoodbye!")
                return

            if not prompt:
                continue
            if prompt in {"/exit", "exit", "quit", "/quit"}:
                print("Goodbye!")
                return

            self.history.append(prompt)
            self.handle_prompt(prompt)

    def handle_prompt(self, prompt: str) -> None:
        if prompt == "/help":
            print(HELP_TEXT)
            return

        if prompt.startswith("/"):
            self._handle_slash_command(prompt)
            return

        lowered = prompt.lower()
        if lowered.startswith("list"):
            target = prompt.split(maxsplit=1)[1] if len(prompt.split()) > 1 else "."
            self.list_path(target)
            return
        if lowered.startswith("read file ") or lowered.startswith("read "):
            self.read_file(prompt.split(maxsplit=2)[-1])
            return
        if lowered.startswith("run:") or lowered.startswith("run "):
            cmd = prompt.split(":", 1)[1].strip() if ":" in prompt else prompt[4:].strip()
            self.run_command(cmd)
            return
        if lowered.startswith("create folder "):
            self.make_dir(prompt[len("create folder ") :].strip())
            return
        if lowered.startswith("delete file "):
            self.delete_path(prompt[len("delete file ") :].strip())
            return

        print("I didn't understand that prompt. Use /help.")

    def _handle_slash_command(self, prompt: str) -> None:
        parts = prompt.split(maxsplit=1)
        cmd = parts[0]
        arg = parts[1] if len(parts) > 1 else ""

        if cmd == "/pwd":
            print(self.cwd)
        elif cmd == "/cd":
            if not arg:
                print("Usage: /cd <path>")
                return
            self.change_dir(arg)
        elif cmd == "/history":
            self.show_history()
        elif cmd == "/list":
            self.list_path(arg or ".")
        elif cmd == "/tree":
            self.tree(arg or ".")
        elif cmd == "/search":
            if not arg:
                print("Usage: /search <pattern> [path]")
                return
            self.search(arg)
        elif cmd == "/read":
            if not arg:
                print("Usage: /read <path>")
                return
            self.read_file(arg)
        elif cmd in {"/write", "/append"}:
            if ":::" not in arg:
                print(f"Usage: {cmd} <path> ::: <content>")
                return
            path, content = arg.split(":::", 1)
            self.write_file(path.strip(), content.lstrip(), append=(cmd == "/append"))
        elif cmd == "/mkdir":
            if not arg:
                print("Usage: /mkdir <path>")
                return
            self.make_dir(arg)
        elif cmd == "/delete":
            if not arg:
                print("Usage: /delete <path>")
                return
            self.delete_path(arg)
        elif cmd in {"/copy", "/move"}:
            if ":::" not in arg:
                print(f"Usage: {cmd} <src> ::: <dest>")
                return
            src, dst = [p.strip() for p in arg.split(":::", 1)]
            if cmd == "/copy":
                self.copy_path(src, dst)
            else:
                self.move_path(src, dst)
        elif cmd == "/run":
            if not arg:
                print("Usage: /run <shell command>")
                return
            self.run_command(arg)
        else:
            print("Unknown command. Type /help.")

    def _display_cwd(self) -> str:
        try:
            return str(self.cwd.relative_to(self.root)) or "."
        except ValueError:
            return str(self.cwd)

    def _confirm(self, message: str) -> bool:
        if self.auto_approve:
            return True
        response = input(f"{message} [y/N]: ").strip().lower()
        return response in {"y", "yes"}

    def resolve_path(self, raw_path: str) -> Path:
        path = Path(raw_path).expanduser()
        if not path.is_absolute():
            path = (self.cwd / path).resolve()
        else:
            path = path.resolve()
        self._ensure_inside_root(path)
        return path

    def _ensure_inside_root(self, path: Path) -> None:
        if path == self.root:
            return
        if self.root not in [path, *path.parents]:
            raise ValueError(f"Path escapes root sandbox: {path}")

    def change_dir(self, raw_path: str) -> None:
        try:
            path = self.resolve_path(raw_path)
        except ValueError as exc:
            print(exc)
            return
        if not path.exists() or not path.is_dir():
            print(f"Not a directory: {path}")
            return
        self.cwd = path
        print(f"Changed directory to {self.cwd}")

    def show_history(self) -> None:
        if not self.history:
            print("No history yet.")
            return
        for idx, item in enumerate(self.history, 1):
            print(f"{idx:>3}. {item}")

    def list_path(self, raw_path: str) -> None:
        try:
            path = self.resolve_path(raw_path)
        except ValueError as exc:
            print(exc)
            return
        if not path.exists():
            print(f"Path does not exist: {path}")
            return
        if path.is_file():
            print(path)
            return
        entries = sorted(path.iterdir(), key=lambda p: (p.is_file(), p.name.lower()))
        if not entries:
            print("(empty directory)")
            return
        for entry in entries:
            mark = "📁" if entry.is_dir() else "📄"
            print(f"{mark} {entry.name}")

    def tree(self, raw_path: str, depth: int = 2) -> None:
        try:
            base = self.resolve_path(raw_path)
        except ValueError as exc:
            print(exc)
            return
        if not base.exists():
            print(f"Path does not exist: {base}")
            return

        def walk(path: Path, level: int) -> None:
            prefix = "  " * level
            print(f"{prefix}{'📁' if path.is_dir() else '📄'} {path.name}")
            if level >= depth or not path.is_dir():
                return
            for child in sorted(path.iterdir(), key=lambda p: (p.is_file(), p.name.lower())):
                walk(child, level + 1)

        walk(base, 0)

    def search(self, arg: str) -> None:
        parts = arg.split(maxsplit=1)
        pattern = parts[0].lower()
        target = parts[1] if len(parts) > 1 else "."
        try:
            base = self.resolve_path(target)
        except ValueError as exc:
            print(exc)
            return
        if not base.exists():
            print(f"Path does not exist: {base}")
            return

        matches: list[Path] = []
        iterable = base.rglob("*") if base.is_dir() else [base]
        for p in iterable:
            if pattern in p.name.lower():
                matches.append(p)
            if len(matches) >= 100:
                break

        if not matches:
            print("No matches found.")
            return
        for m in matches:
            rel = m.relative_to(self.root)
            print(rel)

    def read_file(self, raw_path: str) -> None:
        try:
            path = self.resolve_path(raw_path)
        except ValueError as exc:
            print(exc)
            return
        if not path.exists() or not path.is_file():
            print(f"File not found: {path}")
            return
        size = path.stat().st_size
        if size > self.max_read_bytes:
            print(f"Refusing to read large file ({size} bytes). Use a smaller file.")
            return
        try:
            text = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            print("Cannot read binary/non-UTF8 file.")
            return
        print(f"--- {path} ---")
        print(text)
        print("--- end ---")

    def write_file(self, raw_path: str, content: str, append: bool) -> None:
        try:
            path = self.resolve_path(raw_path)
        except ValueError as exc:
            print(exc)
            return
        action = "append to" if append else "write"
        if not self._confirm(f"About to {action} {path}. Continue?"):
            print("Cancelled.")
            return
        path.parent.mkdir(parents=True, exist_ok=True)
        mode = "a" if append else "w"
        with path.open(mode, encoding="utf-8") as f:
            f.write(content)
            if not content.endswith("\n"):
                f.write("\n")
        print(f"Done: {path}")

    def make_dir(self, raw_path: str) -> None:
        try:
            path = self.resolve_path(raw_path)
        except ValueError as exc:
            print(exc)
            return
        if not self._confirm(f"Create directory {path}?"):
            print("Cancelled.")
            return
        path.mkdir(parents=True, exist_ok=True)
        print(f"Created: {path}")

    def delete_path(self, raw_path: str) -> None:
        try:
            path = self.resolve_path(raw_path)
        except ValueError as exc:
            print(exc)
            return
        if not path.exists():
            print(f"Path does not exist: {path}")
            return
        if not self._confirm(f"Delete {path}? This cannot be undone."):
            print("Cancelled.")
            return
        if path.is_dir():
            shutil.rmtree(path)
        else:
            path.unlink()
        print(f"Deleted: {path}")

    def copy_path(self, src_raw: str, dst_raw: str) -> None:
        try:
            src = self.resolve_path(src_raw)
            dst = self.resolve_path(dst_raw)
        except ValueError as exc:
            print(exc)
            return
        if not src.exists():
            print(f"Source does not exist: {src}")
            return
        if not self._confirm(f"Copy {src} -> {dst}?"):
            print("Cancelled.")
            return
        if src.is_dir():
            shutil.copytree(src, dst, dirs_exist_ok=True)
        else:
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)
        print(f"Copied to: {dst}")

    def move_path(self, src_raw: str, dst_raw: str) -> None:
        try:
            src = self.resolve_path(src_raw)
            dst = self.resolve_path(dst_raw)
        except ValueError as exc:
            print(exc)
            return
        if not src.exists():
            print(f"Source does not exist: {src}")
            return
        if not self._confirm(f"Move {src} -> {dst}?"):
            print("Cancelled.")
            return
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(src), str(dst))
        print(f"Moved to: {dst}")

    def run_command(self, command: str) -> None:
        if not self._confirm(f"About to run command in {self.cwd}: {command}"):
            print("Cancelled.")
            return
        try:
            completed = subprocess.run(
                command,
                shell=True,
                cwd=self.cwd,
                text=True,
                capture_output=True,
                env=os.environ.copy(),
            )
        except Exception as exc:  # noqa: BLE001
            print(f"Failed to run command: {exc}")
            return
        if completed.stdout:
            print(completed.stdout.rstrip())
        if completed.stderr:
            print(completed.stderr.rstrip(), file=sys.stderr)
        print(f"[exit code: {completed.returncode}]")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Local terminal assistant agent")
    parser.add_argument("--root", default=str(SAFE_DEFAULT_ROOT), help="Assistant root sandbox.")
    parser.add_argument("--yes", action="store_true", help="Auto-approve mutating actions.")
    parser.add_argument(
        "--max-read-kb",
        type=int,
        default=256,
        help="Max file size for /read in KB (default: 256).",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    assistant = LocalAssistant(root=Path(args.root), auto_approve=args.yes, max_read_kb=args.max_read_kb)
    assistant.start()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
